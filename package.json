{
  "name": "skin-cut",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "db:setup": "node scripts/apply-supabase-schema.mjs",
    "db:migrate": "node scripts/apply-supabase-schema.mjs",
    "db:admin": "node scripts/apply-supabase-schema.mjs set-admin-markrock.sql",
    "db:bootstrap": "node scripts/apply-supabase-schema.mjs 004",
    "dev:api": "node api-server.mjs",
    "dev:mock-api": "node api-server.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "fetch:assets": "node scripts/fetch-skin-images.mjs",
    "fetch:assets:rov": "node scripts/fetch-skin-images.mjs --game=rov --limit=10",
    "fetch:assets:mlbb": "node scripts/fetch-skin-images.mjs --game=mlbb --limit=10",
    "build:arena": "node scripts/build-arena-catalog.mjs",
    "sync:game-logos": "node scripts/sync-sortskin-logos.mjs",
    "sync:sortskin": "node scripts/sync-sortskin-catalog.mjs --game=all --json-only",
    "sync:sortskin:local": "node scripts/sync-sortskin-catalog.mjs --game=all",
    "sync:sortskin:rov": "node scripts/sync-sortskin-catalog.mjs --game=rov",
    "sync:sortskin:rov:json": "node scripts/sync-sortskin-catalog.mjs --game=rov --json-only",
    "sync:sortskin:mlbb": "node scripts/sync-sortskin-catalog.mjs --game=mlbb",
    "sync:sortskin:mlbb:json": "node scripts/sync-sortskin-catalog.mjs --game=mlbb --json-only",
    "preview": "vite preview",
    "extract:apk": "node scripts/extract-apk.mjs",
    "extract:rov:from-phone": "node scripts/pull-rov-apk-and-extract.mjs",
    "extract:rov:textures": "python3 scripts/extract-rov-textures.py",
    "extract:rov:cache": "node scripts/pull-rov-cache-from-phone.mjs",
    "extract:rov:textures:cache": "python3 scripts/extract-rov-textures.py --src=scratch/rov-phone-cache",
    "export:rov:frames": "bash scripts/export-rov-assetstudio.sh",
    "export:rov:frames:all": "EXPORT_ALL=1 bash scripts/export-rov-assetstudio.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.105.4",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
