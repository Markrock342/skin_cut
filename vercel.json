{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/sortskin-assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sortskin-assets/:path*",
      "destination": "https://pub-603937e0ef90496f818f5e96bc337ba7.r2.dev/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
