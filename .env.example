VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# อีเมลแอดมิน (คั่นด้วย comma) — สำรองก่อนตั้ง is_admin ใน DB
# VITE_ADMIN_EMAILS=you@example.com

# Analytics (opt-in ผ่านแบนเนอร์คุกกี้ — โหลดสคริปต์เมื่อผู้ใช้กดยอมรับ)
# VITE_ENABLE_ANALYTICS=true
# VITE_ANALYTICS_PROVIDER=plausible
# VITE_PLAUSIBLE_DOMAIN=yourdomain.com
# --- หรือ Google Analytics ---
# VITE_ANALYTICS_PROVIDER=ga
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ถ้ามี service role (รัน schema อัตโนมัติเท่านั้น — ห้ามใส่ใน frontend)
# รัน npm run db:migrate — เลือกอย่างใดอย่างหนึ่ง:
# SUPABASE_ACCESS_TOKEN=   # supabase.com/dashboard/account/tokens
# SUPABASE_DB_PASSWORD=    # Project Settings → Database → password
